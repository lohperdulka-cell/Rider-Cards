{
  "name": "ridercards",
  "private": true,
  "description": "Frontend toolchain for RiderCards: Tailwind CSS build and Neon service config.",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i app/static/css/tailwind.src.css -o app/static/css/app.css --minify",
    "build:watch": "tailwindcss -c tailwind.config.js -i app/static/css/tailwind.src.css -o app/static/css/app.css --watch",
    "neon:plan": "neon config plan",
    "neon:deploy": "neon deploy"
  },
  "dependencies": {
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
