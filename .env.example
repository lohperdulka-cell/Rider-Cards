# --- Core ---
ENV=dev
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-please-32chars-min
DATABASE_URL=sqlite+aiosqlite:///./data/ridercards.db
# Postgres: plain `postgresql://` or `postgres://` is upgraded to asyncpg
# automatically. `sslmode` is rewritten to asyncpg's `ssl`; `channel_binding`
# is dropped. Do not hand-edit those two.
# DATABASE_URL=postgresql+asyncpg://ridercards:ridercards@localhost:5432/ridercards

# Neon only. The request path uses the pooled URL; migrations and DDL use the
# unpooled one. Leave both empty elsewhere and DATABASE_URL is used for both.
# DATABASE_URL_POOLED=postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pw@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Cookies / session ---
SESSION_COOKIE_NAME=rc_session
SESSION_MAX_AGE=1209600
COOKIE_SECURE=false

# --- Default admin (created on first boot or via `make create-admin`) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ChangeMe_StrongPassw0rd!
ADMIN_EMAIL=admin@ridercards.dev

# --- i18n ---
DEFAULT_LOCALE=ru
SUPPORTED_LOCALES=ru,en

# --- Shop settings ---
CURRENCY=RUB
SUPPORT_EMAIL=support@ridercards.example
